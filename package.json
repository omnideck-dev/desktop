{
  "name": "omnideck-desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:app": "bash scripts/dev.sh",
    "build": "tsc && vite build",
    "build:appimage": "bash scripts/build-appimage.sh",
    "run:appimage": "bash scripts/run-appimage.sh",
    "preview": "vite preview",
    "tauri": "tauri",
    "fetch:sidecars": "node scripts/fetch-sidecars.mjs",
    "verify:sidecars": "node scripts/verify-sidecars.mjs",
    "test:policy": "node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "lint:rust": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "format:rust": "cargo fmt --manifest-path src-tauri/Cargo.toml -- --check",
    "verify": "npm run fetch:sidecars && npm run verify:sidecars && npm run test:policy && npm run typecheck && npm run format:rust && npm run test:rust && npm run lint:rust"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-shell": "^2.3.5",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.4"
  }
}
